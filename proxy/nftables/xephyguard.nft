#!/usr/sbin/nft -f
# XephyGuard gateway ruleset (gateway mode). Rendered by ccc-deploy/install.sh which replaces
# @LAN_IF@, @WAN_IF@, @CCC_IP@, @LAB_SUBNET@, @PROXY_PORT@ and @AGENT_PORT@.
# Set *elements* are updated at runtime by xg_netpolicy (sets.nft, resolver-sets.nft); the rules below are static.
#
# Layers (cheapest first):
#   1. all lab DNS is forced to the CCC resolver (Unbound with per-client views)
#   2. public DoH/DoT resolvers are dropped by IP and port 853
#   3. QUIC (UDP 443) is dropped so browsers fall back to TCP that the proxy can see
#   4. TCP 80/443 is redirected to the transparent proxy (SNI filter, selective inspection)
#   5. Test-mode clients get no other egress; isolated clients only reach the agent port
#   6. block_ai clients may not reach VPN/tunnel ports (vpn_tcp_ports / vpn_udp_ports, from data/ YAML)

table inet xephyguard
delete table inet xephyguard

table inet xephyguard {
    set test_clients     { type ipv4_addr; }
    set block_ai_clients { type ipv4_addr; }
    set isolated_clients { type ipv4_addr; }
    # exempt_clients is filled by xg_netpolicy but no rule reads it: exempt PCs get the plain lab path,
    # which is what a PC in no set gets. Kept so `nft list set` shows them and the set names match GROUPS.
    set exempt_clients   { type ipv4_addr; }
    set resolver_ips     { type ipv4_addr; flags interval; }
    set resolver_ips6    { type ipv6_addr; flags interval; }
    set vpn_tcp_ports    { type inet_service; }
    set vpn_udp_ports    { type inet_service; }

    chain prerouting_nat {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "@LAN_IF@" ip saddr @isolated_clients return
        iifname "@LAN_IF@" udp dport 53 ip daddr != @CCC_IP@ dnat ip to @CCC_IP@:53
        iifname "@LAN_IF@" tcp dport 53 ip daddr != @CCC_IP@ dnat ip to @CCC_IP@:53
        iifname "@LAN_IF@" tcp dport { 80, 443 } ip daddr != @CCC_IP@ redirect to :@PROXY_PORT@
    }

    chain input {
        type filter hook input priority filter; policy accept;
        # WAN side (I-PROXY-3): the proxy listeners, Unbound, the dashboard and every other host port
        # are for the lab only. Nothing from the WAN reaches them; see wan_input.
        iifname "@WAN_IF@" jump wan_input
        # Isolated PCs may only talk to the agent endpoint (so commands and alerts keep flowing).
        iifname "@LAN_IF@" ip saddr @isolated_clients tcp dport != @AGENT_PORT@ drop
        iifname "@LAN_IF@" ip saddr @isolated_clients udp dport != 53 drop
    }

    # Traffic arriving on the WAN card: replies to the CCC's own connections, ICMP (PMTU, ping),
    # DHCP replies if the WAN address is leased, and SSH for administration. Everything else
    # (proxy 8080/8085, DNS 53, 80/443/8443, MySQL, Reverb, ...) is dropped.
    chain wan_input {
        ct state established,related accept
        ct state invalid counter drop
        meta l4proto { icmp, ipv6-icmp } accept
        udp sport 67 udp dport 68 accept comment "DHCPv4 client"
        udp sport 547 udp dport 546 accept comment "DHCPv6 client"
        tcp dport 22 accept comment "SSH administration"
        counter drop comment "WAN: proxy, DNS and other host ports"
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        # Restricted PCs come before the established accept (I-PROXY-4): a VPN/SSH tunnel opened
        # before a Test session or isolation is an established flow. Their web and DNS traffic goes
        # to the CCC itself (input), so they need no forwarded traffic in either direction.
        # xg_netpolicy also deletes their conntrack entries when they join these sets.
        iifname "@LAN_IF@" ip saddr @isolated_clients counter drop
        iifname "@LAN_IF@" ip saddr @test_clients counter drop comment "Test mode: proxy path only"
        oifname "@LAN_IF@" ip daddr @isolated_clients counter drop
        oifname "@LAN_IF@" ip daddr @test_clients counter drop
        # block_ai PCs keep normal egress except VPN/tunnel ports (I-PROXY-18). Also before the
        # established accept, so a tunnel opened before the PC joined block_ai stops at its next packet.
        iifname "@LAN_IF@" ip saddr @block_ai_clients tcp dport @vpn_tcp_ports counter drop comment "block_ai: VPN/tunnel"
        iifname "@LAN_IF@" ip saddr @block_ai_clients udp dport @vpn_udp_ports counter drop comment "block_ai: VPN/tunnel"
        ct state established,related accept
        iifname "@LAN_IF@" udp dport 443 counter drop comment "QUIC"
        iifname "@LAN_IF@" meta l4proto { tcp, udp } th dport 853 counter drop comment "DoT"
        iifname "@LAN_IF@" ip daddr @resolver_ips counter drop comment "public resolvers / DoH"
        iifname "@LAN_IF@" ip6 daddr @resolver_ips6 counter drop
        iifname "@LAN_IF@" oifname "@WAN_IF@" ip saddr @LAB_SUBNET@ accept
    }

    chain postrouting_nat {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "@WAN_IF@" masquerade
    }
}
