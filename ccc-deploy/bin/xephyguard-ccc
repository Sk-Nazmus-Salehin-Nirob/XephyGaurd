#!/usr/bin/env bash
# xephyguard-ccc: day-to-day CCC administration.
#   doctor        host + application checks with plain-language fixes
#   status        container status
#   logs [svc]    follow logs (web, worker, proxy, netpolicy, analysis, ...)
#   enroll-key    show the lab enrollment key (--rotate to replace it)
#   backup DIR    database dump + CA + settings into DIR
#   update        rebuild images, migrate, restart
#   artisan ...   run a Laravel artisan command (as www-data)
# The doctor checks are "test && ok || bad": ok is a printf that cannot fail, so bad runs only when the test fails.
# shellcheck disable=SC2015
set -uo pipefail
XG_DEPLOY=/opt/xephyguard/ccc-deploy
cd "$XG_DEPLOY" || { echo "XephyGuard not installed in $XG_DEPLOY"; exit 1; }
# Parsed, not sourced: a value is never run as shell (I-CCC-21).
# shellcheck source=ccc-deploy/bin/xg-env.sh
. "$XG_DEPLOY/bin/xg-env.sh" || { echo "missing $XG_DEPLOY/bin/xg-env.sh"; exit 1; }
xg_env_load ./.env || exit 1
dc() { docker compose "$@"; }
ok()   { printf '  \033[32m✔\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✘\033[0m %s\n      → %s\n' "$1" "$2"; FAIL=1; }
FAIL=0

doctor() {
  # The mode the proxy and netpolicy run: state.json first, .env only before the server has written it (I-CCC-9).
  mode=$(jq -r '.network_mode // empty' /var/lib/xephyguard/net/state.json 2>/dev/null || true)
  XG_NETWORK_MODE=${mode:-${XG_NETWORK_MODE:-gateway}}
  echo "Host (network mode: $XG_NETWORK_MODE)"
  if [ "$XG_NETWORK_MODE" = gateway ]; then   # forwarding is needed (and checked) only on the gateway (I-CCC-29)
    [ "$(sysctl -n net.ipv4.ip_forward)" = 1 ] && ok "IP forwarding on" || bad "IP forwarding is off" "sudo sysctl -w net.ipv4.ip_forward=1 (install.sh makes it permanent)"
    nft list table inet xephyguard >/dev/null 2>&1 && ok "nftables gateway rules loaded" || bad "nftables rules missing" "sudo nft -f /etc/nftables.d/xephyguard.nft"
    ip -4 addr show dev "$XG_LAN_IF" | grep -q "inet $XG_CCC_IP/" && ok "$XG_CCC_IP on $XG_LAN_IF" || bad "$XG_CCC_IP is not configured on $XG_LAN_IF" "set a fixed IP with netplan, then sudo netplan apply"
  else
    nft list table inet xephyguard_input >/dev/null 2>&1 && ok "nftables proxy_only input filter loaded" || bad "proxy_only input filter missing (proxy and DNS open beyond the lab)" "sudo nft -f /etc/nftables.d/xephyguard-proxy-only.nft"
  fi
  timedatectl show -p NTPSynchronized --value | grep -q yes && ok "Clock synchronised (NTP)" || bad "Clock not synchronised" "sudo systemctl restart chrony; lab PCs use the CCC as time authority"
  free=$(df -BG --output=avail /var/lib/xephyguard | tail -1 | tr -dc 0-9)
  [ "${free:-0}" -gt 5 ] && ok "${free} GB free on /var/lib/xephyguard" || bad "Low disk space (${free} GB)" "shorten raw-event retention in Settings or add disk"
  echo "Services"
  for s in mysql web reverb worker scheduler netpolicy proxy analysis discovery; do
    st=$(dc ps --format '{{.Service}} {{.State}}' 2>/dev/null | awk -v s=$s '$1==s{print $2}')
    [ "$st" = running ] && ok "$s running" || bad "$s is ${st:-not running}" "sudo xephyguard-ccc logs $s"
  done
  dig +time=2 +tries=1 @127.0.0.1 example.com A +short >/dev/null && ok "DNS resolver answers" || bad "DNS resolver not answering" "sudo xephyguard-ccc logs netpolicy (is something else using port 53?)"
  # NXDOMAIN is the sinkhole; no answer at all is a failure too, not a pass (I-CCC-23).
  doh=$(dig +time=2 +tries=1 +noall +comments @127.0.0.1 dns.google A 2>/dev/null || true)
  case $doh in
    *"status: NXDOMAIN"*) ok "DoH resolvers are sinkholed" ;;
    *"status: NOERROR"*)  bad "dns.google still resolves" "check /var/lib/xephyguard/net/unbound-xephyguard.conf" ;;
    *)                    bad "DoH sinkhole not checked: no answer from the resolver" "sudo xephyguard-ccc logs netpolicy" ;;
  esac
  (exec 3<>"/dev/tcp/$XG_CCC_IP/8080") 2>/dev/null && ok "Proxy listening on $XG_CCC_IP:8080" || bad "Proxy not listening" "sudo xephyguard-ccc logs proxy"
  # Verified against the lab CA under the certificate's name, never curl -k (I-CCC-22).
  curl -sf --max-time 3 --cacert /var/lib/xephyguard/ca/ca.crt --resolve xephyguard-ccc:443:127.0.0.1 \
    "https://xephyguard-ccc/up" >/dev/null && ok "Dashboard reachable (TLS verified with the lab CA)" \
    || bad "Dashboard not reachable on 443 with a certificate from the lab CA" "sudo xephyguard-ccc logs web"
  # The fingerprint operators compare with the one in the Linux install command and on the Downloads page (I-CCC-2).
  if fp=$(openssl x509 -in /var/lib/xephyguard/ca/ca.crt -noout -fingerprint -sha256 2>/dev/null); then
    ok "Lab CA fingerprint (SHA-256): $(printf '%s' "${fp#*=}" | tr -d ':' | tr 'A-F' 'a-f')"
  else
    bad "Lab CA certificate not readable" "sudo xephyguard-ccc logs web (the setup creates /var/lib/xephyguard/ca/ca.crt)"
  fi
  echo "Application"
  dc exec -T -u www-data web php artisan xephyguard:doctor || FAIL=1
  exit $FAIL
}

# A subshell, so set -e and umask stay inside. Every file holds student data or secrets: umask 077 before
# anything is created (I-CCC-8), and "written" only after a complete dump (I-CCC-5). Each step also has its
# own check, because bash ignores set -e when the caller tests the function (backup || ...).
backup() (
  set -e
  umask 077
  out=${1:?usage: xephyguard-ccc backup DIR}
  ts=$(date +%Y%m%d-%H%M)
  db="$out/xephyguard-db-$ts.sql.gz"
  fail() { echo "Backup FAILED: $1; the files in $out are incomplete" >&2; exit 1; }
  install -d -m 0700 "$out" || fail "cannot create $out"
  dc exec -T mysql sh -c 'command -v mysqldump' >/dev/null 2>&1 \
    || fail "mysqldump not available in the mysql container (is it running? sudo xephyguard-ccc status)"
  # pipefail (top of the script) makes a mysqldump error fail the pipeline; the trailer catches a truncated dump.
  # MYSQL_PWD from the mysql container's own env, inside its shell: no password in any argv (I-CCC-20).
  # shellcheck disable=SC2016  # expanded by the container's sh, on purpose
  if ! dc exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysqldump -uroot --single-transaction xephyguard' | gzip > "$db" \
     || ! gzip -t "$db" || ! gzip -dc "$db" | tail -n 1 | grep -q '^-- Dump completed'; then
    rm -f "$db"
    fail "database dump failed (root password changed, or MySQL down? sudo xephyguard-ccc logs mysql)"
  fi
  tar -czf "$out/xephyguard-ca-$ts.tgz" -C /var/lib/xephyguard ca || fail "cannot archive /var/lib/xephyguard/ca"
  cp .env "$out/xephyguard-env-$ts" || fail "cannot copy .env"
  chmod 0600 "$db" "$out/xephyguard-ca-$ts.tgz" "$out/xephyguard-env-$ts" || fail "cannot chmod the backup files"
  echo "Backup written to $out (contains the CA private key and secrets: store it safely)"
)

case "${1:-}" in
  doctor) doctor ;;
  status) dc ps ;;
  logs) shift; dc logs -f --tail=200 "$@" ;;
  enroll-key) shift; dc exec -T -u www-data web php artisan xephyguard:enroll-key "$@" ;;
  backup) backup "${2:-}" ;;
  # up runs the one-shot migrate service first; the app roles start only if it succeeds (I-CCC-24).
  update) dc build && dc up -d ;;
  # As www-data, the owner of the app files: a root run would leave root-owned state.json, cache or logs (I-CCC-10).
  artisan) shift; dc exec -u www-data web php artisan "$@" ;;
  *) sed -n '2,10p' "$0" ;;
esac
